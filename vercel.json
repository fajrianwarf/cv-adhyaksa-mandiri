{
  "version": 2,
  "routes": [
    { "src": "/.*", "dest": "/no-access.html" }
  ],
  "headers": [
    {
      "source": "/no-access.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ]
}
